# Copy this file to .env. The collector loads it on startup and never
# overrides variables that are already set in the environment.
#
# These values are for a local demo only. Do not reuse them anywhere else.

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://collector:collector@localhost:5432/machine_data

# Optional OPC UA user. Leave both unset for anonymous access,
# which is what the bundled simulator expects.
# OPCUA_USERNAME=
# OPCUA_PASSWORD=

# LOG_LEVEL=INFO
# LOG_FORMAT=json
